pipeline {
  agent any

  stages {
    stage('Clone') {
      steps {
        git branch: "${BRANCH_NAME}",
        url: 'https://github.com/<your-username>/devops-build-capstone.git'
      }
    }

    stage('Build') {
      steps {
        sh './build.sh'
      }
    }

    stage('Push Image') {
      steps {
        script {
          if (env.BRANCH_NAME == 'dev') {
            sh '''
              docker tag devops-build <dockerhub-username>/devops-build-dev:latest
              docker push <dockerhub-username>/devops-build-dev:latest
            '''
          }
          if (env.BRANCH_NAME == 'master') {
            sh '''
              docker tag devops-build <dockerhub-username>/devops-build-prod:latest
              docker push <dockerhub-username>/devops-build-prod:latest
            '''
          }
        }
      }
    }
  }
}
